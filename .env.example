# Required IMAP connection settings. Do not put a real password in this file.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=mailbox@example.com

# Set exactly one password source. Prefer IMAP_PASSWORD_FILE in production.
# IMAP_PASSWORD=replace-with-a-secret-from-your-environment
IMAP_PASSWORD_FILE=/run/secrets/imap_password

# TLS is always verified. Supported modes: implicit_tls, starttls.
IMAP_TLS_MODE=implicit_tls

# Comma-separated allowlist of mailboxes exposed by the server.
IMAP_ALLOWED_MAILBOXES=INBOX

# Server-side safety limits. Tool callers cannot increase them.
IMAP_MAX_RESULTS=25
IMAP_MAX_BODY_BYTES=65536
IMAP_MAX_ATTACHMENT_BYTES=5242880
IMAP_MAX_QUERY_LENGTH=256
IMAP_TIMEOUT_SECONDS=20

# Compose ports. Change each port here; the same value is used inside the container
# and published on localhost, including the health check.
MCP_PORT=8700
MCP_DEV_PORT=8701

# Private Streamable HTTP listener for non-Compose launches.
MCP_HOST=127.0.0.1

# Chatgpt tunnel ID configuration
CONTROL_PLANE_TUNNEL_ID=tunnel_....
MCP_TUNNEL_PORT=8702
