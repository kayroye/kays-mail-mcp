# Reference only: run ./setup.sh to create private settings. Never put credentials here.
IMAP_HOST=imap.mail.me.com
IMAP_PORT=993
IMAP_USERNAME=mailbox@icloud.com
IMAP_ALLOWED_MAILBOXES=INBOX
MCP_PUBLIC_URL=https://mail.example.com
OIDC_ISSUER=https://login.example.com/realms/mail
OIDC_CLIENT_ID=mail-mcp
MCP_OWNER_SUBJECT=replace-with-provisioned-owner-uuid
MCP_ALLOWED_REDIRECT_URIS=http://127.0.0.1:*/callback,http://127.0.0.1:*/callback/*
